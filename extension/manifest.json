{
  "manifest_version": 3,
  "name": "IG Social Graph",
  "version": "2.3.2",
  "description": "Maps who-follows-whom among your Instagram followers and draws it as an interactive graph. Runs locally in your browser.",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG Social Graph"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sebasfavaron.github.io/IG-Social-Graph-Tool/*",
        "http://localhost:8765/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
